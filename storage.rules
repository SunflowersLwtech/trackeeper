rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Request images: scoped to requests/{requestId}/{fileName}
    match /requests/{requestId}/{fileName} {
      // Read: only participants (request owner, assigned maintainer, or manager)
      allow read: if request.auth != null
        && (
          firestore.get(/databases/(default)/documents/requests/$(requestId)).data.tenantId == request.auth.uid
          || firestore.get(/databases/(default)/documents/requests/$(requestId)).data.assignedTo == request.auth.uid
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "manager"
        );

      // Write: only the request's tenant owner or a manager
      // Must be image, max 10MB
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (
          firestore.get(/databases/(default)/documents/requests/$(requestId)).data.tenantId == request.auth.uid
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "manager"
        );
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
