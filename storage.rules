rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Request media: any path under requests/{requestId}/...
    // Includes:
    //   • requests/{id}/{ts}.jpg              tenant-uploaded request photos
    //   • requests/{id}/chat/{ts}.jpg         chat attachments
    //   • requests/{id}/proof/{ts}.jpg        maintainer completion proof (future)
    //
    // The {path=**} multi-segment wildcard is required — Firebase Storage
    // matchers are exact-segment unless you use **, so the previous
    // single-segment {fileName} matcher silently denied chat sub-paths.
    match /requests/{requestId}/{path=**} {
      // Read: any authenticated app user may resolve request media URLs.
      // Product visibility is controlled by Firestore request reads: users
      // only receive imageUrls for requests they are allowed to open.
      allow read: if request.auth != null;

      // Write: any authenticated app user may upload request media. The file
      // only becomes visible in the product after the request document is
      // updated, and that Firestore update remains role/owner-gated. Avoid
      // brittle mobile failures caused by device-specific blob metadata.
      allow write: if request.auth != null;
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
