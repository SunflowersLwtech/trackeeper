rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return getUserDoc().data.role;
    }

    function getUserStatus() {
      return getUserDoc().data.get("status", "active");
    }

    function isActiveUser() {
      return request.auth != null && getUserStatus() == "active";
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidStatus(status) {
      return status in ["submitted", "assigned", "in_progress", "completed", "cancelled", "on_hold"];
    }

    function isValidCategory(cat) {
      return cat in ["Plumbing", "Electrical", "General"];
    }

    function isValidPriority(p) {
      return p in ["low", "medium", "high"];
    }

    function isValidUserStatus(s) {
      return s in ["pending_approval", "active", "suspended", "rejected"];
    }

    // Returns true if the named field on the request is unchanged across the
    // pending update — accounts for the field being absent on either side.
    function fieldUnchanged(name) {
      return request.resource.data.get(name, null) == resource.data.get(name, null);
    }

    // Money-bearing fields that only a manager may mutate.
    function moneyFieldsUnchanged() {
      return fieldUnchanged("cost") && fieldUnchanged("payment");
    }

    // ─── Users collection ───
    match /users/{userId} {
      // Read: any authenticated user (needed for sender names, maintainer list).
      allow read: if isAuthenticated();

      // Create: tenant self-registration (must start as pending_approval) OR manager provisioning any role.
      allow create: if (
        // Public tenant self-registration — must enter pending_approval state
        (isOwner(userId)
          && request.resource.data.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == "tenant"
          && request.resource.data.status == "pending_approval")
        ||
        // Manager provisioning any role (tenant onboarding is admin-driven per spec).
        (getUserRole() == "manager"
          && request.resource.data.uid == userId
          && request.resource.data.role in ["tenant", "maintainer", "manager"]
          && isValidUserStatus(request.resource.data.status))
      )
        && request.resource.data.keys().hasAll(["uid", "email", "name", "role", "status"])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && isValidUserStatus(request.resource.data.status);

      // Update: covers (a) self-edit on safe fields, (b) push-token write, (c) manager approval flips.
      allow update: if isAuthenticated() && (
        // Self update — name, phone, unitNumber, hourlyRate, specialties, pushToken
        (isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          // Cannot promote self from pending_approval — only manager can
          && request.resource.data.get("status", "active") == resource.data.get("status", "active")
        )
        ||
        // Manager approval / suspension / rejection of any user
        (getUserRole() == "manager"
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && isValidUserStatus(request.resource.data.status)
        )
      );

      allow delete: if false;

      // ─── Per-user notifications ───
      match /notifications/{notificationId} {
        // Owner reads own notifications; manager can read for any user (admin overview).
        allow read: if isAuthenticated() && (isOwner(userId) || getUserRole() == "manager");

        // Anyone authenticated may create a notification doc directed at userId
        // (we use this from clients to fan-out — fields are validated).
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasAll(["kind", "title", "body", "read", "createdAt"])
          && request.resource.data.read == false
          && request.resource.data.kind is string
          && request.resource.data.title is string
          && request.resource.data.body is string;

        // Owner can mark as read.
        allow update: if isOwner(userId)
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.title == resource.data.title
          && request.resource.data.body == resource.data.body
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.read is bool;

        allow delete: if false;
      }
    }

    // ─── Requests collection ───
    match /requests/{requestId} {

      // Read: tenants see own, managers see all, maintainers see assigned
      allow read: if isAuthenticated() && (
        getUserRole() == "manager" ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.get("assignedTo", "") == request.auth.uid
      );

      // Create: only active tenants. Priority becomes a server-suggested or default value.
      // We do NOT trust tenant-supplied priority blindly — managers can override later.
      // Money fields (cost / payment) must NEVER be set at creation by a tenant.
      allow create: if isAuthenticated()
        && getUserRole() == "tenant"
        && getUserStatus() == "active"
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.status == "submitted"
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && isValidCategory(request.resource.data.category)
        && isValidPriority(request.resource.data.priority)
        && !("cost" in request.resource.data)
        && !("payment" in request.resource.data);

      // Update: role-based.
      allow update: if isAuthenticated() && (

        // ── Manager: status transitions, assignment, priority override, cost, payment ──
        (getUserRole() == "manager"
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.tenantName == resource.data.tenantName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.category == resource.data.category
          && isValidStatus(request.resource.data.status)
          && (
            (resource.data.status == "submitted" && request.resource.data.status == "assigned")
            || (resource.data.status == "assigned" && request.resource.data.status == "on_hold")
            || (resource.data.status == "in_progress" && request.resource.data.status == "on_hold")
            || (resource.data.status == "on_hold" && request.resource.data.status in ["assigned", "in_progress"])
            || (request.resource.data.status == resource.data.status)
          )
        ) ||

        // ── Tenant: content edits, cancellation, rating ──
        (getUserRole() == "tenant"
          && resource.data.tenantId == request.auth.uid
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.tenantName == resource.data.tenantName
          && request.resource.data.createdAt == resource.data.createdAt
          && (!("assignedTo" in resource.data) || request.resource.data.get("assignedTo", "") == resource.data.assignedTo)
          // Tenant must NEVER mutate money fields — only manager owns cost/payment.
          && moneyFieldsUnchanged()
          && (
            // Edit content while still submitted (statusHistory immutable)
            (request.resource.data.status == resource.data.status
              && resource.data.status == "submitted"
              && request.resource.data.statusHistory == resource.data.statusHistory)
            // Cancel from submitted or assigned
            || (request.resource.data.status == "cancelled"
              && resource.data.status in ["submitted", "assigned"])
            // Rate when completed
            || (request.resource.data.status == resource.data.status
              && resource.data.status == "completed"
              && request.resource.data.statusHistory == resource.data.statusHistory
              && request.resource.data.rating is number
              && request.resource.data.rating >= 1
              && request.resource.data.rating <= 5)
          )
        ) ||

        // ── Maintainer: status transitions only ──
        (getUserRole() == "maintainer"
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.tenantName == resource.data.tenantName
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.assignedToName == resource.data.assignedToName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.title == resource.data.title
          && request.resource.data.description == resource.data.description
          && request.resource.data.category == resource.data.category
          // Maintainer must NEVER mutate money fields.
          && moneyFieldsUnchanged()
          && isValidStatus(request.resource.data.status)
          && (
            (resource.data.status == "assigned" && request.resource.data.status in ["in_progress", "on_hold"])
            || (resource.data.status == "in_progress" && request.resource.data.status in ["completed", "on_hold"])
            || (resource.data.status == "on_hold" && request.resource.data.status in ["assigned", "in_progress"])
          )
        ) ||

        // ── Typing-indicator update: only the `typing` field may differ. ──
        // Allowed for the request's tenant, the assigned maintainer, or any manager.
        (request.auth != null
          && (resource.data.tenantId == request.auth.uid
               || resource.data.get("assignedTo", "") == request.auth.uid
               || getUserRole() == "manager")
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.tenantName == resource.data.tenantName
          && request.resource.data.title == resource.data.title
          && request.resource.data.description == resource.data.description
          && request.resource.data.category == resource.data.category
          && request.resource.data.priority == resource.data.priority
          && request.resource.data.status == resource.data.status
          && request.resource.data.statusHistory == resource.data.statusHistory
          // Money fields and assignment must remain frozen during a typing ping.
          && moneyFieldsUnchanged()
          && fieldUnchanged("assignedTo")
          && fieldUnchanged("assignedToName")
          && fieldUnchanged("rating")
        )
      );

      allow delete: if false;

      // ─── Messages subcollection ───
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          getUserRole() == "manager" ||
          get(/databases/$(database)/documents/requests/$(requestId)).data.tenantId == request.auth.uid ||
          get(/databases/$(database)/documents/requests/$(requestId)).data.get("assignedTo", "") == request.auth.uid
        );

        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.senderName is string
          && (
            getUserRole() == "manager" ||
            get(/databases/$(database)/documents/requests/$(requestId)).data.tenantId == request.auth.uid ||
            get(/databases/$(database)/documents/requests/$(requestId)).data.get("assignedTo", "") == request.auth.uid
          );

        // Allow read-receipt updates: only readBy and updatedAt, sender stays the same.
        allow update: if isAuthenticated()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.senderName == resource.data.senderName
          && request.resource.data.text == resource.data.text
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            getUserRole() == "manager" ||
            get(/databases/$(database)/documents/requests/$(requestId)).data.tenantId == request.auth.uid ||
            get(/databases/$(database)/documents/requests/$(requestId)).data.get("assignedTo", "") == request.auth.uid
          );

        allow delete: if false;
      }

      // ─── Notes subcollection (manager only) ───
      match /notes/{noteId} {
        allow read: if isAuthenticated() && getUserRole() == "manager";

        allow create: if isAuthenticated()
          && getUserRole() == "manager"
          && request.resource.data.managerId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.managerName is string;

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
