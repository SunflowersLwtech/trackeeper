rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Requests collection
    match /requests/{requestId} {
      // Tenants read own, managers read all, maintainers read assigned
      allow read: if request.auth != null && (
        getUserRole() == "manager" ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid
      );

      // Only tenants can create requests
      allow create: if request.auth != null && getUserRole() == "tenant";

      // Update rules by role
      allow update: if request.auth != null && (
        getUserRole() == "manager" ||
        (getUserRole() == "tenant" && resource.data.tenantId == request.auth.uid) ||
        (getUserRole() == "maintainer" && resource.data.assignedTo == request.auth.uid)
      );

      // Messages: participants only (tenant + manager + assigned maintainer)
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          getUserRole() == "manager" ||
          get(/databases/$(database)/documents/requests/$(requestId)).data.tenantId == request.auth.uid ||
          get(/databases/$(database)/documents/requests/$(requestId)).data.assignedTo == request.auth.uid
        );
        allow create: if request.auth != null && (
          getUserRole() == "manager" ||
          get(/databases/$(database)/documents/requests/$(requestId)).data.tenantId == request.auth.uid ||
          get(/databases/$(database)/documents/requests/$(requestId)).data.assignedTo == request.auth.uid
        );
      }

      // Notes: manager only
      match /notes/{noteId} {
        allow read: if request.auth != null && getUserRole() == "manager";
        allow create: if request.auth != null && getUserRole() == "manager";
      }
    }
  }
}
